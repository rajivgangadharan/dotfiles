{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-antigravity-auth@latest"],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "gemma3:4b": {}
      }
    },
    "cohere": {
      "npm": "@ai-sdk/cohere",
      "name": "Cohere",
      "options": {
        "apiKey": "${COHERE_API_KEY}"
      },
      "models": {
        "command-r-plus": {},
        "command-r": {},
        "command": {}
      }
    }
  },
  "model": "deepseek/deepseek-v4-flash"
}
