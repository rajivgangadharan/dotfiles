# ====================
# Office-specific Configuration
# ====================

# Add office-specific configurations here

# Homebrew
[[ -x "$HOME/homebrew/bin/brew" ]] && eval "$($HOME/homebrew/bin/brew shellenv)"

# pyenv
export PYENV_ROOT="$HOME/.pyenv"
export PATH="$PYENV_ROOT/libexec:$PYENV_ROOT/bin:$PATH"
if command -v pyenv &>/dev/null; then
  eval "$(pyenv init -)"
fi

# vi -> neovim if available
if command -v nvim &>/dev/null; then
  alias vi='nvim'
fi

# Azure ML Compute (XX.157.246.83)
alias start-ml-compute='az ml compute start --name $COMPUTE_NAME --resource-group $RESOURCE_GROUP --workspace-name $WORKSPACE_NAME'
alias connect-ml-compute='ssh azureuser@XX.157.246.83'
